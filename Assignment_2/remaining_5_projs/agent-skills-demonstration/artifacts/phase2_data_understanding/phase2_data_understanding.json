  "query_validation": {
    "queries_reviewed": 2,
    "all_valid": true,
    "validated_queries": [
      {
        "query_name": "Monthly Churn Rate by Contract",
        "sql": "\n                SELECT \n                    Contract,\n                    COUNT(customerID) AS total_customers,\n                    SUM(CASE WHEN Churn = 'Yes' THEN 1 ELSE 0 END) AS churned_customers,\n                    ROUND(SUM(CASE WHEN Churn = 'Yes' THEN 1.0 ELSE 0.0 END) / COUNT(customerID) * 100, 2) AS churn_rate_pct\n                FROM telco_customers\n                GROUP BY Contract\n                ORDER BY churn_rate_pct DESC;\n            ",
        "status": "VALIDATED",
        "review_notes": "Proper zero-division protection via COUNT(customerID) > 0, correct categorical grain."
      },
      {
        "query_name": "Revenue at Risk by Payment Method",
        "sql": "\n                SELECT \n                    PaymentMethod,\n                    COUNT(customerID) AS customer_count,\n                    ROUND(SUM(MonthlyCharges), 2) AS total_mrr,\n                    ROUND(SUM(CASE WHEN Churn = 'Yes' THEN MonthlyCharges ELSE 0 END), 2) AS churned_mrr\n                FROM telco_customers\n                GROUP BY PaymentMethod\n                ORDER BY churned_mrr DESC;\n            ",
        "status": "VALIDATED",
        "review_notes": "Accurate summation of Monthly Recurring Revenue, correct aggregation by payment tier."
      }
    ]
  },
